{
  "name": "lodestar",
  "version": "1.0.0",
  "private": true,
  "description": "Describe a trip in your own words. Lodestar charts it into a star-map itinerary you can reorder, trim and refine.",
  "type": "module",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "start": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:dev\"",
    "dev": "vite",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "serve": "cross-env NODE_ENV=production node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
