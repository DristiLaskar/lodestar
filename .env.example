# ── Which model should answer? ───────────────────────────────────────────
# Presets: groq | gemini | openrouter | openai | ollama
# All of them speak the OpenAI-compatible /chat/completions protocol, so one
# small client in server/llm.js covers every provider.
AI_PROVIDER=groq
AI_API_KEY=

# Optional overrides (defaults come from the preset in server/provider.js)
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1

# Run with canned demo data and no API key (useful for UI work):
# AI_MOCK=true

PORT=8787
# RATE_LIMIT_PER_MIN=20
